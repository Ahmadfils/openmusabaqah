# PostgreSQL connection used by the application.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/openmusabaqah?schema=public"

# Direct connection used by Prisma CLI migrations / db push.
# On hosted providers (Neon, Supabase, etc.) this is often different from DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/openmusabaqah?schema=public"

# Absolute URL of the deployment. Used to render public links in the admin UI.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret used to sign session cookies. Minimum 16 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-secret"
