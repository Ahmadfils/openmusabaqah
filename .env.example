# PostgreSQL connection used by the application.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/openmusabaqa?schema=public"

# Direct connection used by Prisma CLI migrations / db push.
# On hosted providers (Neon, Supabase, etc.) this is often different from DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/openmusabaqa?schema=public"

# Absolute URL of the deployment. Used to render public links in the admin UI.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret used to sign session cookies. Minimum 16 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-secret"

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# Transactional provider: resend | brevo | smtp | console.
# Leave unset to auto-detect, or set "console" for local development
# (messages are logged to the server console and verification links are
# returned to the browser).
EMAIL_PROVIDER="console"
EMAIL_FROM="OpenMusabaqa <no-reply@openmusabaqa.org>"

# Resend (https://resend.com) for verification and judge invitations.
RESEND_API_KEY=""

# Brevo (https://brevo.com) for newsletter contacts and bulk campaigns.
BREVO_API_KEY=""
BREVO_LIST_ID=""

# SMTP fallback (Nodemailer) when EMAIL_PROVIDER="smtp".
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
